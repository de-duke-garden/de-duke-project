# CI/deploy variable file for the GCP Terraform tree -- committed so local
# terraform runs (infra changes) can use the same non-secret values without a
# local terraform.tfvars (which is gitignored). Only NON-secret values live
# here: project ID, public hostnames, and DNS/Vercel targets are all public
# record.
#
# NOTE: image_tag is deliberately NOT set here. The deployed image is owned
# by CI/CD (backend-deploy-gcp.yml updates Cloud Run via `gcloud run`), and
# Terraform ignores the image attribute (lifecycle.ignore_changes in
# cloud_run.tf) -- infra applies never touch or revert the deployed image.

gcp_project_id      = "de-duke-services"
gcp_project_number  = "531781610440"
media_bucket_suffix = "531781610440"

api_domain = "api.de-duke.org"
cdn_domain = "cdn.de-duke.org"

# Vercel CNAME targets must be re-captured from the Vercel projects after
# de-duke.org / admin.de-duke.org are added there (see README, "Domain
# migration"). The values below are stale .com-era targets, kept only so
# plan/apply remains syntactically complete.
admin_fqdn                    = "admin.de-duke.org"
vercel_cname_target           = "4e88bf4fa2333825.vercel-dns-017.com."
marketing_fqdn                = "de-duke.org"
marketing_www_fqdn            = "www.de-duke.org"
vercel_marketing_cname_target = "1c969cc0900a2edb.vercel-dns-017.com."
